  },
  "keywords": [
    "postgres",
    "migrations",
    "linter",
    "ci",
    "zero-downtime"
  ],
  "dependencies": {
    "@ballast/core": "0.4.0",
    "commander": "^12.1.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
