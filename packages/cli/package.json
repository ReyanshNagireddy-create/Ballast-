{
  "name": "@ballast/cli",
  "version": "0.4.0",
  "description": "Ballast CLI — catch dangerous Postgres migrations before they reach production.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "ballast": "./dist/index.js"
  },
  "main": "./dist/api.js",
  "types": "./dist/api.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ballast-dev/ballast",
