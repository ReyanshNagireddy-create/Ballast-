# ── Database ────────────────────────────────────────────────────────────────
# Application database (Prisma models + pg-boss job queue in `pgboss` schema).
DATABASE_URL=postgresql://ballast:ballast@localhost:5432/ballast

# Disposable database for migration rehearsals. NEVER point this at production.
# Optional: rehearsals fail cleanly with a clear error when unset.
REHEARSAL_DATABASE_URL=

# ── Web ─────────────────────────────────────────────────────────────────────
# Public URL of the site (used for SEO metadata, API URLs in responses).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Clerk (authentication) ──────────────────────────────────────────────────
# Create an application at https://dashboard.clerk.com — required for the
# dashboard; the marketing site and public API work without them.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Stripe (billing) ────────────────────────────────────────────────────────
# Only needed to sell the Team plan. Self-hosters can leave these empty.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID for the Team plan ($99/mo flat). Create in the Stripe dashboard.
STRIPE_TEAM_PRICE_ID=

# ── GitHub App (PR annotations) ─────────────────────────────────────────────
# Lets the worker post check runs with inline annotations. Optional.
GITHUB_APP_ID=
# The app's PEM private key with literal \n for newlines.
GITHUB_APP_PRIVATE_KEY=

# ── CLI (developers/CI, not the server) ─────────────────────────────────────
# BALLAST_API_KEY=blt_live_...       # project settings → API keys
# BALLAST_API_URL=https://ballast.dev/api/v1
